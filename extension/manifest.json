{
  "manifest_version": 3,
  "name": "猫步下载器 · Maobu Fetch",
  "short_name": "Maobu Fetch",
  "version": "0.8.5",
  "description": "安全地接管下载并将页面媒体发送到猫步下载器。",
  "permissions": [
    "contextMenus",
    "cookies",
    "downloads",
    "scripting",
    "storage",
    "tabs",
    "notifications",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:17433/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "src/icon16.png",
    "32": "src/icon32.png",
    "48": "src/icon48.png",
    "128": "src/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "猫步下载器",
    "default_icon": {
      "16": "src/icon16.png",
      "32": "src/icon32.png",
      "48": "src/icon48.png",
      "128": "src/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-takeover": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "临时暂停/恢复下载接管（10 分钟）"
    },
    "send-page-media": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "把当前页面的媒体发送到猫步下载器"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content-ui.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
